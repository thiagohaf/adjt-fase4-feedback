            },
            "description": "Requer ESTUDANTE ou ADMINISTRADOR."
          },
          "response": []
        },
        {
          "name": "Criar aula no curso (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Aula Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cursos/{{cursoId}}/aulas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cursos", "{{cursoId}}", "aulas"]
            },
            "description": "Requer ADMINISTRADOR."
          },
          "response": []
        },
        {
          "name": "Inscrever em curso (Estudante)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cursos/{{cursoId}}/inscricoes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cursos", "{{cursoId}}", "inscricoes"]
            },
            "description": "Requer ESTUDANTE. Com token Admin → 403."
          },
          "response": []
        }
      ]
    },
