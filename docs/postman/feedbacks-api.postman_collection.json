    {
      "name": "Erros de autenticação",
      "item": [
        {
          "name": "Rota protegida sem token (401 AUTH_MISSING_TOKEN)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cursos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cursos"]
            },
            "description": "Esperado: 401 `AUTH_MISSING_TOKEN` com `traceId`."
          },
          "response": []
        },
        {
          "name": "Token inválido (401 AUTH_INVALID_TOKEN)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "token-invalido",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cursos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cursos"]
            },
            "description": "Esperado: 401 `AUTH_INVALID_TOKEN`."
          },
          "response": []
